---
import { personalProjects } from '../data/personalProjects';
import type { PersonalProject } from '../data/personalProjects';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const list = personalProjects[lang];
const basePath = lang === 'en' ? '/en/projects' : '/projects';

const i18n = {
  es: {
    title: 'Proyectos personales',
    subtitle: 'Cosas que construyo y mantengo por mi cuenta, fuera del trabajo.',
    viewDetail: 'Ver detalle',
  },
  en: {
    title: 'Personal projects',
    subtitle: 'Things I build and maintain on my own, outside of work.',
    viewDetail: 'View detail',
  },
};

const t = i18n[lang];

const linkIcons: Record<string, string> = {
  github: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  dockerhub: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M13.98 11.08h2.12a.19.19 0 0 0 .19-.19V9.01a.19.19 0 0 0-.19-.19h-2.12a.18.18 0 0 0-.18.18v1.9c0 .1.08.18.18.18m-2.95-5.43h2.12a.19.19 0 0 0 .18-.19V3.57a.19.19 0 0 0-.18-.18h-2.12a.18.18 0 0 0-.19.18v1.9c0 .1.09.18.19.18m0 2.71h2.12a.19.19 0 0 0 .18-.18V6.29a.19.19 0 0 0-.18-.18h-2.12a.18.18 0 0 0-.19.18v1.89c0 .1.09.18.19.18m-2.93 0h2.12a.19.19 0 0 0 .18-.18V6.29a.18.18 0 0 0-.18-.18H8.1a.18.18 0 0 0-.18.18v1.89c0 .1.08.18.18.18m-2.96 0h2.11a.19.19 0 0 0 .19-.18V6.29a.18.18 0 0 0-.19-.18H5.14a.19.19 0 0 0-.19.18v1.89c0 .1.08.18.19.18m5.89 2.72h2.12a.19.19 0 0 0 .18-.19V9.01a.19.19 0 0 0-.18-.19h-2.12a.18.18 0 0 0-.19.18v1.9c0 .1.09.18.19.18m-2.93 0h2.12a.18.18 0 0 0 .18-.19V9.01a.18.18 0 0 0-.18-.19H8.1a.18.18 0 0 0-.18.18v1.9c0 .1.08.18.18.18m-2.96 0h2.11a.18.18 0 0 0 .19-.19V9.01a.18.18 0 0 0-.18-.19H5.14a.19.19 0 0 0-.19.19v1.88c0 .1.08.19.19.19m-2.92 0h2.12a.18.18 0 0 0 .18-.19V9.01a.18.18 0 0 0-.18-.19H2.22a.18.18 0 0 0-.19.18v1.9c0 .1.08.18.19.18m21.54-1.19c-.06-.05-.67-.51-1.95-.51-.34 0-.68.03-1.01.09a3.77 3.77 0 0 0-1.72-2.57l-.34-.2-.23.33a4.6 4.6 0 0 0-.6 1.43c-.24.97-.1 1.88.4 2.66a4.7 4.7 0 0 1-1.75.42H.76a.75.75 0 0 0-.76.75 11.38 11.38 0 0 0 .7 4.06 6.03 6.03 0 0 0 2.4 3.12c1.18.73 3.1 1.14 5.28 1.14.98 0 1.96-.08 2.93-.26a12.25 12.25 0 0 0 3.82-1.4 10.5 10.5 0 0 0 2.61-2.13c1.25-1.42 2-3 2.55-4.4h.23c1.37 0 2.21-.55 2.68-1 .3-.3.55-.66.7-1.06l.1-.28Z"/></svg>`,
};

const linkLabels: Record<string, string> = { github: 'GitHub', dockerhub: 'Docker Hub' };
---

<section id="side-projects" class="container mx-auto py-16 px-4">
  <h2 class="text-3xl font-bold text-white mb-3 text-center">{t.title}</h2>
  <p class="text-gray-400 text-center mb-12 text-sm max-w-xl mx-auto">{t.subtitle}</p>

  <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {list.map((project: PersonalProject) => {
      const badgeLinks = project.links.filter((l) => l.kind === 'github' || l.kind === 'dockerhub');
      return (
        <div class="group relative flex flex-col bg-gray-800 rounded-xl p-5 border border-gray-700 hover:border-indigo-500 transition-colors duration-300">
          <a
            href={`${basePath}/${project.slug}`}
            class="absolute inset-0 z-0 rounded-xl"
            aria-label={`${t.viewDetail}: ${project.title}`}
          />

          <div class="flex items-start justify-between gap-2 mb-3">
            <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">
              {project.status}
            </span>

            {badgeLinks.length > 0 && (
              <div class="relative z-10 flex items-center gap-1.5 shrink-0">
                {badgeLinks.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={linkLabels[link.kind]}
                    aria-label={`${linkLabels[link.kind]} — ${project.title}`}
                    class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-700 text-gray-300 hover:bg-indigo-500/20 hover:text-indigo-300 transition-colors"
                  >
                    <Fragment set:html={linkIcons[link.kind]} />
                  </a>
                ))}
              </div>
            )}
          </div>

          <div class="flex items-center gap-3 mb-2">
            {project.logo && (
              <img src={project.logo} alt="" width="40" height="40" class="w-10 h-10 object-contain shrink-0" />
            )}
            <h3 class="text-lg font-bold text-white leading-snug group-hover:text-indigo-300 transition-colors">
              {project.title}
            </h3>
          </div>

          <p class="text-gray-400 text-sm leading-relaxed mb-4 flex-1">
            {project.tagline}
          </p>

          <div class="flex flex-wrap gap-1.5 mb-4">
            {project.technologies.slice(0, 5).map((tech) => (
              <span class="flex items-center gap-1 text-[11px] bg-gray-700 text-gray-300 px-2 py-1 rounded-full">
                {tech.icon && (
                  <img src={`/icons/tech/${tech.icon}.svg`} alt={tech.name} width="12" height="12" class="w-3 h-3 object-contain" />
                )}
                {tech.name}
              </span>
            ))}
          </div>

          <span class="text-sm text-indigo-400 group-hover:text-indigo-300 font-semibold transition-colors inline-flex items-center gap-1">
            {t.viewDetail}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      );
    })}
  </div>
</section>
